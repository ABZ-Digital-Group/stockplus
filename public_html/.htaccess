# 1. Point to the app in the main folder (Flattened structure)
PassengerAppRoot /home/u216291154/domains/stockplus.online
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs18/root/bin/node
PassengerStartupFile server.js
PassengerBaseURI /

# 2. Critical: Point to the tmp folder at the root
PassengerRestartDir /home/u216291154/domains/stockplus.online/tmp

# 3. Security
RewriteRule ^\.builds - [F,L]